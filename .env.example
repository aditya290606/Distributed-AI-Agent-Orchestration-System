# ==============================================================================
# Environment Configuration Template (NEXUS AI - Milestone 1)
# Copy this file to .env and adjust variables as required.
# Never commit actual secrets or the .env file to version control.
# ==============================================================================

# Core Application Settings
APP_NAME="Distributed AI Agent Orchestration System"
APP_VERSION="0.1.0"
API_VERSION="v1"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
SECRET_KEY="development-insecure-secret-key-change-in-production-min32chars"
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# MySQL Database Configuration (Milestone 1)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=""
DB_NAME=nexus_ai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Google Gemini API Configuration (Milestone 2)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT=60.0
GEMINI_MAX_RETRIES=3
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.2

# Redis Broker & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=

# Celery Distributed Tasks
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false
