# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and provide the appropriate secrets for your environment.
# Never commit actual secrets or the .env file to version control.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="Distributed AI Agent Orchestration System"
APP_VERSION="0.1.0"
HOST=0.0.0.0
PORT=8000
SECRET_KEY="generate-a-secure-random-secret-key-for-production"
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Google Gemini API Settings
GEMINI_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096

# Database Settings (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_orchestrator
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_orchestrator

# Message Broker & Caching (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Distributed Execution (Celery)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# Observability (OpenTelemetry)
OTEL_SERVICE_NAME=agent-orchestrator-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_ENABLED=false

